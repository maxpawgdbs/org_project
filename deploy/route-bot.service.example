[Unit]
Description=Moscow route Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=routebot
WorkingDirectory=/opt/route-bot
EnvironmentFile=/etc/route-bot.env
ExecStart=/usr/bin/python3 -m route_bot.bot
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
